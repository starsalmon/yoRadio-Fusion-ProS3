; Copy to platformio_private.ini (gitignored). Required for USB upload of April's Speaker.
;
; tools/pio/verify_aprils_speaker_upload.py refuses upload/uploadfs unless upload_port is the
; FeatherS3 AND it is the only Espressif (VID 303A) USB device plugged in. Unplug the ProS3 radio
; (and the "GoL" ProS3, MAC 60:55:f9:f5:59:6c) first.
;
; While yoRadio runs (or in ROM download mode) every ESP32-S3 shows up as 303A:1001 "USB JTAG/serial
; debug unit"; its USB serial number is the chip MAC. With only the FeatherS3 plugged in, run
;   pio device list
; and copy that port + serial number below. No serial port is opened by the check.

[env:aprils-speaker]
upload_port = /dev/cu.usbmodemXXXX
custom_upload_mac = xx:xx:xx:xx:xx:xx
; Extra boards to always refuse (space/comma separated MACs). Default: the GoL ProS3.
;custom_refuse_macs = 60:55:f9:f5:59:6c
